{
  "name": "traackr/traackr-api-php",
  "description": "Traackr API PHP Library",
  "keywords": [
    "traackr",
    "api"
  ],
  "homepage": "https://traackr.com/",
  "authors": [
    {
      "name": "David Chancogne",
      "email": "dchancogne@traackr.com",
      "homepage": "http://twitter.com/dchancogne"
